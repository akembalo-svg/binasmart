# BinaSmart's own work — kept out of the public repo on purpose (2026-09-11).
# The CODE is public deliberately: it is the credibility, and the safety gates being readable is the
# strongest support for what /amharic-ai claims. These are the things that took original work and
# cannot be rebuilt from the code — the voice, the yardstick, and the graded questions behind it.
# Backed up to /root/storage/binasmart-private/
knowledge/amharic-style.md
knowledge/oromo-style.md
knowledge/sources-am.json
ops/bini/questions.json
ops/bini/amharic-eval.js
ops/health/afiya-eval.js
ops/law/asmat-eval.js
ops/oromo-eval.js

# Working backups. Old snapshots of a live server do not belong in a public
# repo, and git already holds the history.
ops/backups/

# Operational prompts. The loader and the deterministic gates are public;
# the tuned instructions are not. Backed up to /root/storage/binasmart-private/prompts/
prompts/

# Anything key-shaped. The API keys for the public knowledge endpoints live OUTSIDE this repo, in
# /root/storage/api/keys.json (mode 600), and only ever as a sha256 of the key and the pepper. These
# patterns are the belt to that braces: a keys.json or a usage directory must never land here.
keys.json
api/keys.json
ops/api/keys.json
usage/

# Planetiler download scratch (1.5 GB). The tile rebuild uses pmtiles extract, not planetiler —
# see ops/map/rebuild-tiles.sh. Left here once by an abandoned build; never commit it.
data/
