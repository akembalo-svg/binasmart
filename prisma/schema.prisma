generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== CORE SAAS =====

model Organization {
  id           String        @id @default(cuid())
  name         String
  plan         Plan          @default(STARTER)
  subscription Subscription?
  buildings    Building[]
  users        User[]
  createdAt    DateTime      @default(now())
}

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

model Subscription {
  id               String    @id @default(cuid())
  orgId            String    @unique
  org              Organization @relation(fields: [orgId], references: [id])
  plan             Plan
  status           SubStatus @default(TRIAL)
  currentPeriodEnd DateTime
  paymentMethod    String?
  createdAt        DateTime  @default(now())
}

enum SubStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model User {
  id             String   @id @default(cuid())
  orgId          String?
  org            Organization? @relation(fields: [orgId], references: [id])
  phone          String   @unique
  passwordHash String?
  telegramChatId String?
  telegramId     String?  @unique
  fullName       String
  role           Role     @default(TENANT)
  language       String   @default("am")
  parentUserId   String?
  permissions    String[]
  tenancies      Tenancy[]
  createdAt      DateTime @default(now())
  ownedBuildings Building[]     @relation("BuildingOwner")
  notifications  Notification[]
  orders         Order[]        @relation("Customer")
  reviews        Review[]
  favorites      Favorite[]
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  TECHNICIAN
  TENANT
  STAFF
  PUBLIC
}

// ===== BUILDING & UNITS =====

model Building {
  id         String  @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  ownerId    String
  owner      User    @relation("BuildingOwner", fields: [ownerId], references: [id])
  name       String
  nameAm     String
  city       String
  subCity    String?
  lat        Float?
  lng        Float?
  floors     Int
  qrSlug     String  @unique
  units      Unit[]
  ownerKeys  OwnerKey[]

  threeD_style       String?
  threeD_facadeColor String?
  threeD_width       Float?
  threeD_depth       Float?
  threeD_modelUrl    String?
  threeD_modelType   String?

  facadePhotoUrl   String?
  entrancePhotoUrl String?
  logoUrl          String?
  signText         String?
  tinNumber        String?
  vatRegistered    Boolean @default(false)
  vatNumber        String?
  vatInclusive     Boolean @default(true)
  latePenaltyPct   Int     @default(10)
  penaltiesEnabled Boolean @default(false)
  notifyTenants    Boolean @default(false)
  smsMonthlyLimit  Int     @default(500) // SMS parts per Addis calendar month; 0 = no SMS to tenants
  smsSender        String?               // approved sender name (max 11 characters); null = provider default shortcode
  elecTariff       Float   @default(2.12)
  waterTariff      Float   @default(15)
  expenses         Expense[]
  staff            StaffMember[]
  auditLogs        AuditLog[]
  bankAccounts     Json?

  walkthroughVideoUrl       String?
  threeD_processing         Boolean   @default(false)
  threeD_processStartedAt   DateTime?
  threeD_processCompletedAt DateTime?
  threeD_processError       String?

  marketplaceEnabled Boolean @default(true)
  moderationRequired Boolean @default(false)
  telegramChannelId  String?

  wifiPortalEnabled Boolean @default(false)
  parkingSlots      Int?
  parkingFree       Int?

  events     BuildingEvent[]
  scanEvents QrScanEvent[]
  createdAt  DateTime @default(now())
  buildingType String @default("COMMERCIAL")
  roomTypes    RoomType[]
  hotelBookings HotelBooking[]
  travelTrips  TravelTrip[]
  departments  Department[]
  appointments Appointment[]
  employers     Employer[]   // employers whose office is in this building (jobs, 2026-09-21)
}

model Unit {
  id                 String     @id @default(cuid())
  buildingId         String
  building           Building   @relation(fields: [buildingId], references: [id])
  number             String
  floor              Int
  areaSqm            Float
  monthlyRent        Int
  status             UnitStatus @default(VACANT)
  unitType           UnitType   @default(SHOP)
  storefrontPhotoUrl String?
  tenancies          Tenancy[]
  leads              Lead[]
}

enum UnitStatus {
  OCCUPIED
  VACANT
  MAINTENANCE
  RESERVED
}

enum UnitType {
  SHOP
  OFFICE
  RESIDENTIAL
  WAREHOUSE
  OTHER
}

// ===== TENANCY / BILLING =====

model Tenancy {
  id                  String   @id @default(cuid())
  unitId              String
  unit                Unit     @relation(fields: [unitId], references: [id])
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  profileId           String?
  profile             TenantProfile? @relation(fields: [profileId], references: [id])
  contract            Contract?
  invoices            Invoice[]
  meters              Meter[]
  maintenance         MaintenanceRequest[]
  shop                Shop?
  startDate           DateTime
  endDate             DateTime?
  endReason           String?
  exitInspectionScore Int?
  ownerRating         Int?
  active              Boolean  @default(true)
}

model Contract {
  id                String    @id @default(cuid())
  tenancyId         String    @unique
  tenancy           Tenancy   @relation(fields: [tenancyId], references: [id])
  startDate         DateTime
  endDate           DateTime
  monthlyRent       Int
  depositMonths     Int       @default(2)
  pdfUrl            String?
  signedAt          DateTime?
  renewalNotifiedAt DateTime?
}

model Invoice {
  id          String      @id @default(cuid())
  tenancyId   String
  tenancy     Tenancy     @relation(fields: [tenancyId], references: [id])
  type        InvoiceType @default(RENT)
  amount      Int
  lateFee     Int         @default(0)
  dueDate     DateTime
  paidDate    DateTime?
  daysLate    Int         @default(0)
  paymentCode String?     @unique
  method      String?
  status      InvStatus   @default(PENDING)
  createdAt   DateTime    @default(now())
}

enum InvoiceType {
  RENT
  ELECTRICITY
  WATER
  SERVICE
  PENALTY
  OTHER
}

enum InvStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
  CANCELLED
}

model Meter {
  id        String         @id @default(cuid())
  tenancyId String
  tenancy   Tenancy        @relation(fields: [tenancyId], references: [id])
  meterType MeterType
  serialNo  String?
  tariff    Float
  readings  MeterReading[]
}

enum MeterType {
  ELECTRICITY
  WATER
}

model MeterReading {
  id      String   @id @default(cuid())
  meterId String
  meter   Meter    @relation(fields: [meterId], references: [id])
  reading Float
  photoUrl String?
  readAt  DateTime @default(now())
  readBy  String?
  anomaly Boolean  @default(false)
}

model MaintenanceRequest {
  id           String      @id @default(cuid())
  tenancyId    String?
  tenancy      Tenancy?    @relation(fields: [tenancyId], references: [id])
  buildingId   String?
  type         String
  description  String
  reporterName  String?
  reporterPhone String?
  voiceNoteUrl String?
  photoBefore  String?
  photoAfter   String?
  source       String      @default("APP")
  status       MaintStatus @default(OPEN)
  assignedTo   String?
  flagged      Boolean     @default(false)
  assetTag     String?
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?
}

enum MaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  DONE
  VERIFIED
  CANCELLED
}

model Lead {
  id              String   @id @default(cuid())
  unitId          String
  unit            Unit     @relation(fields: [unitId], references: [id])
  name            String
  phone           String
  source          String   @default("QR")
  budgetMax       Int?
  notifyOnVacancy Boolean  @default(false)
  status          String   @default("NEW")
  createdAt       DateTime @default(now())
}

// ===== MARKETPLACE =====

model Shop {
  id            String       @id @default(cuid())
  tenancyId     String       @unique
  tenancy       Tenancy      @relation(fields: [tenancyId], references: [id])
  name          String
  nameAm        String?
  category      ShopCategory
  description   String?
  descriptionAm String?
  phone         String
  telegram      String?
  socialLink    String?
  photos        String[]
  openingHours  Json?
  isOpenNow     Boolean @default(true)
  avgRating     Float   @default(0)
  reviewCount   Int     @default(0)
  featured      Boolean @default(false)
  featuredUntil DateTime?
  icon          String?
  products      Product[]
  offers        Offer[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  jobPosts      JobPost[]
  slug          String?  @unique     // public page: /shop/<slug>
  tgChatId      String?              // Telegram chat that gets orders/requests (owner pressed the bot link)
  ownerPhone    String?              // the phone that may claim this shop (a pre-authorisation, NOT proof)
  // When the owner proved control: the claim code sent to the Telegram on record, typed back. NOT an
  // ops approval, which only grants access. This is
  // the consent signal - the page is listed, publishes its phone and states its hours only with it.
  claimedAt     DateTime?
  logoUrl       String?
  about         String?              // longer description shown on the page
  aboutAm       String?
  mapUrl        String?
  address       String?
  status        String   @default("live")   // live | hidden | pending
  claims        OwnerClaim[]
  sessions      OwnerSession[]
  memberships   Membership[]
}

enum ShopCategory {
  CAFE
  RESTAURANT
  PHARMACY
  RETAIL
  SERVICE
  GYM
  SALON
  CLINIC
  BANK
  OFFICE
  OTHER
}

model Product {
  id          String  @id @default(cuid())
  shopId      String
  shop        Shop    @relation(fields: [shopId], references: [id])
  name        String
  nameAm      String?
  description String?
  price       Int
  category    String?
  photoUrl    String?
  deliverable Boolean @default(false)
  visible     Boolean @default(true)
  approved    Boolean @default(true)
  orderCount  Int     @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
}

model Offer {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id])
  title          String
  titleAm        String?
  description    String?
  startsAt       DateTime
  endsAt         DateTime
  active         Boolean  @default(true)
  approved       Boolean  @default(true)
  views          Int      @default(0)
  claims         Int      @default(0)
  telegramPosted Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Order {
  id            String      @id @default(cuid())
  shopId        String
  shop          Shop        @relation(fields: [shopId], references: [id])
  customerId    String?
  customer      User?       @relation("Customer", fields: [customerId], references: [id])
  customerName  String?
  customerPhone String?
  deliverToUnit String?
  note          String?
  items         OrderItem[]
  total         Int
  status        OrderStatus @default(NEW)
  paymentMethod String?
  paidAt        DateTime?
  source        String      @default("QR")
  createdAt     DateTime    @default(now())
  completedAt   DateTime?
}

enum OrderStatus {
  NEW
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Int
}

model Review {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?  @unique
  rating    Int
  comment   String?
  photoUrl  String?
  createdAt DateTime @default(now())
}

model Favorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  @@unique([userId, shopId])
}

model JobPost {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  title     String
  salary    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ===== BINASCORE =====

model TenantProfile {
  id             String    @id @default(cuid())
  phone          String    @unique
  fullName       String
  faydaId        String?   @unique
  binaScore      Int       @default(0)
  scoreUpdatedAt DateTime?
  tenancies      Tenancy[]
  paymentRecords PaymentRecord[]
  consents       ScreeningConsent[]
  disputes       ScoreDispute[]
}

model PaymentRecord {
  id        String        @id @default(cuid())
  profileId String
  profile   TenantProfile @relation(fields: [profileId], references: [id])
  dueDate   DateTime
  paidDate  DateTime?
  amount    Int
  daysLate  Int           @default(0)
  unitType  UnitType
}

model ScreeningConsent {
  id             String        @id @default(cuid())
  profileId      String
  profile        TenantProfile @relation(fields: [profileId], references: [id])
  requestedBy    String
  buildingId     String
  otpCode        String?
  otpVerified    Boolean       @default(false)
  reportViewedAt DateTime?
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
}

model ScoreDispute {
  id          String        @id @default(cuid())
  profileId   String
  profile     TenantProfile @relation(fields: [profileId], references: [id])
  targetType  String
  targetId    String
  reason      String
  evidenceUrl String?
  status      String        @default("OPEN")
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
}

// ===== USSD / NOTIFICATIONS / ANALYTICS =====

model UssdLog {
  id        String   @id @default(cuid())
  sessionId String
  phone     String
  path      String
  action    String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  channel   String
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model BuildingEvent {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  title      String
  titleAm    String?
  date       DateTime
  createdAt  DateTime @default(now())
}

model QrScanEvent {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  userAgent  String?
  referrer   String?
  createdAt  DateTime @default(now())

  @@index([buildingId, createdAt])
}


model Expense {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id])
  date        DateTime @default(now())
  vendor      String
  vendorTin   String?
  category    String   @default("GENERAL")
  description String?
  amount      Int
  vatAmount   Int      @default(0)
  receiptNo   String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  actor      String?
  action     String
  detail     String?
  amount     Int?
  createdAt  DateTime @default(now())
}

model StaffMember {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  name       String
  role       String   @default("GUARD")
  phone      String?
  salary     Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ===== BETTER AUTH =====
model AuthUser {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("owner")   // rows created before 9 Sep 2026; new accounts default to "user" in auth.mjs
  buildingSlug  String?
  telegramId    String?  @unique              // set when the account signed in with Telegram
  phone         String?  @unique              // only ever set from a PROVEN number — see phoneVerifiedAt
  phoneVerifiedAt DateTime?                   // null = never proven. A typed phone must never set this.
  memberships   Membership[]
  rider         Rider?
  driver        Driver?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      AuthSession[]
  accounts      AuthAccount[]
  @@map("auth_user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("auth_session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@map("auth_account")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@map("auth_verification")
}

model RoomType {
  id            String   @id @default(cuid())
  buildingId    String
  building      Building @relation(fields: [buildingId], references: [id])
  name          String
  nameAm        String?
  description   String?
  pricePerNight Int
  capacity      Int      @default(2)
  totalRooms    Int      @default(1)
  amenities     String[]
  photos        String[]
  active        Boolean  @default(true)
  bookings      HotelBooking[]
}

model HotelBooking {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  guestName  String
  guestPhone String
  checkIn    DateTime
  checkOut   DateTime
  rooms      Int      @default(1)
  totalPrice Int
  status     String   @default("PENDING")
  code       String   @unique
  note       String?
  createdAt  DateTime @default(now())
}

model TravelTrip {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  fromCity   String
  fromCityAm String?
  toCity     String
  toCityAm   String?
  departure  DateTime
  duration   String?
  busName    String
  price      Int
  seats      Int      @default(44)
  active     Boolean  @default(true)
  tickets    TravelTicket[]
}

model TravelTicket {
  id        String     @id @default(cuid())
  tripId    String
  trip      TravelTrip @relation(fields: [tripId], references: [id])
  name      String
  phone     String
  seats     Int        @default(1)
  total     Int
  code      String     @unique
  status    String     @default("CONFIRMED")
  createdAt DateTime   @default(now())
  paid      Boolean  @default(false)
}

model Department {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id])
  name        String
  nameAm      String?
  nameOm      String?
  icon        String?
  floor       Int      @default(0)
  room        String?
  fee         Int?
  doctors     String[]
  openHours   String?
  slotsPerDay Int      @default(20)
  active      Boolean  @default(true)
  appointments Appointment[]
}

model Appointment {
  id           String     @id @default(cuid())
  buildingId   String
  building     Building   @relation(fields: [buildingId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  name         String
  phone        String
  date         DateTime
  note         String?
  code         String     @unique
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
}

model FlightRequest {
  id         String   @id @default(cuid())
  shopId     String
  tripType   String   @default("ROUND")
  fromCity   String
  toCity     String
  departDate DateTime
  returnDate DateTime?
  passengers Int      @default(1)
  cabin      String   @default("ECONOMY")
  name       String
  phone      String
  note       String?
  status     String   @default("NEW")
  quotedPrice Int?
  code       String   @unique
  createdAt  DateTime @default(now())
}

model DiasporaLead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  country   String?
  city      String?
  building  String?
  units     String?
  note      String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model NewsPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleAm     String?
  category    String
  excerpt     String
  bodyHtml    String
  lang        String   @default("am")
  author      String   @default("ቢና ዜና ዴስክ")
  // A guest byline: when the piece was written by a named person rather than the desk, their own
  // page (LinkedIn, a profile) so the credit is checkable and Google records a Person, not just us.
  authorUrl   String?
  heroEmoji   String?
  readMinutes Int      @default(4)
  evergreen   Boolean  @default(false)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
}

model Tender {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleAm     String?
  category    String
  region      String   @default("Addis Ababa")
  org         String
  summary     String
  bodyHtml    String?
  deadline    DateTime?
  budget      String?
  sourceUrl   String?
  sourceName  String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
}

model Event {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  titleAm    String?
  type       String   @default("CINEMA")
  venue      String
  city       String   @default("Addis Ababa")
  descr      String?
  emoji      String?
  startsAt   DateTime
  durationMin Int     @default(120)
  tiers      Json
  active     Boolean  @default(true)
  tickets    EventTicket[]
  kind        String   @default("FILM")   // FILM | CONCERT | THEATER | MEETUP | OTHER
  posterUrl   String?
  runtimeMin  Int?
  rating      String?                     // "PG-13", "18+"
  language    String?                     // "Amharic", "English (Amharic subtitles)"
  shows       Show[]
}

model EventTicket {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  code      String   @unique
  name      String
  phone     String
  tier      String
  qty       Int      @default(1)
  total     Int
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
  paid      Boolean  @default(false)
}

model InsuranceLead {
  id           String   @id @default(cuid())
  insType      String
  name         String
  phone        String
  city         String?
  coverType    String?
  vehicleType  String?
  vehicleMake  String?
  vehicleYear  String?
  vehicleValue String?
  estimate     String?
  note         String?
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
}

model InsurerPartner {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  products      String
  commissionPct String?
  commissionNote String?
  agreement     String   @default("PROSPECT")
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  priority      Int      @default(0)
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model CarListing {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  make         String?
  model        String?
  year         String?
  price        String?
  mileage      String?
  fuel         String?
  transmission String?
  bodyType     String?
  condition    String?
  city         String?
  imageUrl     String?
  dealer       String?
  dealerPhone  String?
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model PropertyListing {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  listingType  String   @default("sale")
  propertyType String?
  price        String?
  beds         String?
  baths        String?
  area         String?
  city         String?
  location     String?
  imageUrl     String?
  agency       String?
  agencyPhone  String?
  verified     Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model MarketLead {
  id          String   @id @default(cuid())
  kind        String
  listingSlug String?
  listingRef  String?
  name        String
  phone       String
  budget      String?
  note        String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  txRef     String   @unique
  amount    Float
  currency  String   @default("ETB")
  purpose   String?
  email     String?
  name      String?
  phone     String?
  status    String   @default("pending")
  kind      String   @default("checkout")
  meta      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  id        String      @id @default(cuid())
  phone     String      @unique
  pinHash   String
  name      String?
  balance   Float       @default(0)
  token     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  txns      WalletTxn[]
}

model WalletTxn {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  type      String
  amount    Float
  ref       String?
  note      String?
  status    String   @default("success")
  createdAt DateTime @default(now())
}

// ===== BinaSmart Ride =====
model Rider {
  id         String   @id @default(cuid())
  phone      String   @unique
  phoneVerifiedAt DateTime?      // set only when Telegram signed the contact, never when it was typed
  authUserId String?  @unique
  account    AuthUser? @relation(fields: [authUserId], references: [id])
  name       String
  telegramId String?
  rating     Float    @default(5)
  noShows    Int      @default(0)   // pool no-shows in the current window
  lastNoShowAt DateTime?
  rides      Ride[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Driver {
  id              String    @id @default(cuid())
  authUserId      String?   @unique
  account         AuthUser? @relation(fields: [authUserId], references: [id])
  name            String
  phone           String    @unique
  photo           String?
  telegramId      String?
  tier            String
  vehicleMake     String?
  vehicleColour   String?
  plate           String    // not unique: a vehicle may be reassigned between drivers
  licenceUrl      String?
  carPhotoUrl     String?   // front of the car with the plate — shown to riders once approved
  registrationUrl String?
  status          String    @default("pending") // pending | approved | suspended
  online          Boolean   @default(false)
  lat             Float?
  lng             Float?
  lastSeenAt      DateTime?
  rating          Float     @default(5)
  ridesCount      Int       @default(0)
  commissionPct   Float?    // percent (15 = 15%); overrides RideSetting.commissionPct. Phase 2 only — driverTakeEtb is fixed at request time, before assignment.
  bearing         Float?    // degrees, 0 = north, from the last fix
  speedKph        Float?
  away            Boolean   @default(false)  // online but no fix for 45 s: gets no offers
  onRideId        String?   // set inside the accept transaction; must be null to be a candidate
  earningsTodayEtb Int      @default(0)
  earningsDay     DateTime?
  rides           Ride[]
  offers          RideOffer[]
  locations       DriverLocation[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Ride {
  id            String    @id @default(cuid())
  idemKey       String?   @unique
  riderId       String
  rider         Rider     @relation(fields: [riderId], references: [id])
  driverId      String?
  driver        Driver?   @relation(fields: [driverId], references: [id])
  tier          String
  pickup        Json      // { lat, lng, label }
  dropoff       Json      // { lat, lng, label }
  distanceM     Int
  durationS     Int
  fareEtb       Int
  driverTakeEtb Int
  paymentMethod String    @default("cash")    // cash | chapa | telebirr | wallet
  paymentStatus String    @default("unpaid")  // unpaid | paid
  status        String    @default("requested") // requested|dispatching|assigned|arriving|arrived|ontrip|completed|cancelled
  cancelledBy   String?
  concierge     Boolean   @default(false)
  estimate      Boolean   @default(false)
  bookedBy      Json?     // { name, phone, telegramId } when the booker is not the passenger (diaspora etc.)
  riderName     String    // snapshot at request time — do not backfill from Rider
  riderPhone    String    // snapshot at request time
  riderRating   Int?
  driverRating  Int?
  driverAcceptedAt DateTime?
  offers        RideOffer[]
  locations     DriverLocation[]
  pool          Pool?
  requestedAt   DateTime  @default(now())
  assignedAt    DateTime?
  arrivedAt     DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?

  @@index([status])
  @@index([riderId])
  @@index([driverId])
}

// BinaPool: one car being filled on a commute corridor. Once dispatched it is carried by ONE Ride
// (fare = the ladder's driver total); seats hold each rider's own price.
// Bini knowledge index (RAG): one row per text chunk, Gemini embedding as float32 bytes (no pgvector needed;
// the API keeps the matrix in RAM). hash = sha1(source|slug|text) so re-ingest only touches changed chunks.
// Bini per-user memory: key = tg:<telegramId> | web:<uid>. Home/work/lastPickup/lastDropoff = {label, lat, lng}.
model AssistantUser {
  key         String   @id
  telegramId  String?
  name        String?
  phone       String?
  lang        String?
  home        Json?
  work        Json?
  lastPickup  Json?
  lastDropoff Json?
  notes       String?
  visits      Int      @default(1)
  seenAt      DateTime @default(now())
  createdAt   DateTime @default(now())
}

// Every Bini turn: what was asked, what was answered, which tools ran, and whether it was a miss (for the weekly review).
model AssistantLog {
  id        String   @id @default(cuid())
  userKey   String
  channel   String   @default("web")
  lang      String   @default("en")
  message   String
  reply     String
  tools     String[] @default([])
  miss      Boolean  @default(false)
  ms        Int      @default(0)
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([miss, createdAt])
}

model KnowledgeChunk {
  id        String   @id @default(cuid())
  source    String   // skill | addis | guide | page | llms | docs
  slug      String
  url       String?
  title     String
  lang      String   @default("en")
  ord       Int
  hash      String   @unique
  text      String
  internal  Boolean  @default(false) // true = never served to the public search / MCP
  embedding Bytes?
  // BGE-M3 (bina-embed, 127.0.0.1:3031): 1024 float32, L2-normalised, same byte layout as `embedding`. Used only when
  // the Gemini query embedding fails. Added 2026-09-15 by prisma/sql/20260915_knowledge_chunk_embedding_local.up.sql.
  embeddingLocal Bytes?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@index([source, slug])
}

model Pool {
  id           String     @id @default(cuid())
  kind         String     @default("corridor") // corridor | custom ("group near me": any start -> any destination)
  corridorKey  String     // "<line>:<in|out>" — ride/pool/corridors.js; "custom" for a group near me
  pickup       Json?      // custom: { lat, lng, label }
  dropoff      Json?
  createdBy    String?    // custom: the phone that started the group
  womenOnly    Boolean    @default(false)
  driverId     String?    // a driver-opened car: pre-assigned, no auction
  groupId      String?    // a daily group's car for today
  tier         String
  seats        Int        // capacity
  status       String     @default("filling") // filling | dispatching | cancelled (afterwards: the Ride's status)
  seatFareEtb  Int?
  rideId       String?    @unique
  ride         Ride?      @relation(fields: [rideId], references: [id])
  openedAt     DateTime   @default(now())
  dispatchAt   DateTime
  dispatchedAt DateTime?
  poolSeats    PoolSeat[]

  @@index([status])
  @@index([corridorKey, status])
  @@index([driverId])
}

// Daily groups (contract commute): an organizer, a start, a destination, days and a time; members join once.
model PoolGroup {
  id             String   @id @default(cuid())
  name           String
  kind           String   @default("daily")
  pickup         Json
  dropoff        Json
  days           Int      // bitmask Mon=1 … Sun=64
  timeMin        Int      // departure, minutes after midnight, Addis time
  seats          Int
  tier           String
  womenOnly      Boolean  @default(false)
  organizerPhone String
  organizerName  String?
  status         String   @default("active") // active | closed
  lastOpenedDay  String?  // YYYY-MM-DD (Addis) of the last car opened
  members        PoolGroupMember[]
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([organizerPhone])
}

model PoolGroupMember {
  id         String    @id @default(cuid())
  groupId    String
  group      PoolGroup @relation(fields: [groupId], references: [id])
  riderName  String
  riderPhone String
  telegramId String?
  status     String    @default("active") // active | left
  joinedAt   DateTime  @default(now())

  @@unique([groupId, riderPhone])
  @@index([riderPhone])
}

model PoolSeat {
  id            String   @id @default(cuid())
  poolId        String
  pool          Pool     @relation(fields: [poolId], references: [id])
  riderId       String?
  riderName     String
  riderPhone    String
  telegramId    String?
  stopId        String
  status        String   @default("held") // held | boarded | noshow | cancelled
  paymentMethod String   @default("cash")
  fareEtb       Int?
  paidAt        DateTime? // set when the seat was paid online (telebirr); cash seats stay null
  joinedAt      DateTime @default(now())

  @@index([poolId])
  @@index([riderPhone])
}

model RideSetting {
  id        String   @id
  json      String
  updatedAt DateTime @updatedAt
}

model RideOffer {
  id        String   @id @default(cuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id])
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  status    String   @default("open")   // open | accepted | declined | expired | lost
  etaS      Int?                        // driving seconds to pickup when offered
  distanceM Int?
  round     Int      @default(1)        // 1 = 3 km, 2 = 6 km, 3 = 10 km
  tgMsgId   Int?
  createdAt DateTime @default(now())
  decidedAt DateTime?

  @@unique([rideId, driverId])
  @@index([rideId, status])
  @@index([driverId, status])
  @@index([status, createdAt])
}

model DriverLocation {
  id        String   @id @default(cuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  rideId    String?
  ride      Ride?    @relation(fields: [rideId], references: [id])
  lat       Float
  lng       Float
  bearing   Float?
  speedKph  Float?
  at        DateTime @default(now())

  @@index([driverId, at])
  @@index([rideId, at])
}

// ---------------- Cinema & events: seat booking (Phase A) ----------------
model Venue {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  nameAm    String?
  address   String?
  lat       Float?
  lng       Float?
  phone     String?
  // The door key for this venue's staff, as sha256 of the key. The key itself is shown once when
  // it is minted and is never stored, so a stolen database yields no working door key. Minting
  // again replaces it, which is how a lost or leaked key is retired.
  scanKeyHash String? @unique
  scanKeyAt   DateTime?
  website   String?
  notes     String?   // halls/seats/source as researched; verify before the first show
  // Reaching the cinema itself. Every phone number here was read off a blog, a directory or a
  // Facebook page - none of it came from the venue, and a number nobody has dialled is a guess with
  // a plus sign in front of it. These columns are where calling turns the guess into a fact, and
  // where the answer is kept so the next person does not ring the same cinema again.
  contactName  String?
  contactRole  String?      // "manager", "ticket office", "owner"
  phoneChecked DateTime?    // when somebody actually got through on it
  outreach     String   @default("new")   // new | called | no_answer | interested | declined | signed
  outreachNote String?
  outreachAt   DateTime?
  active    Boolean   @default(true)
  halls     Hall[]
  programme Programme[]
  createdAt DateTime  @default(now())
  claims    OwnerClaim[]
  sessions  OwnerSession[]
  memberships Membership[]
}

model Hall {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id])
  name      String
  layout    Json     // { rows, seatsPerRow, aisles, blocked, wheelchair, sections }
  capacity  Int
  shows     Show[]
}

model Show {
  id               String    @id @default(cuid())
  eventId          String
  event            Event     @relation(fields: [eventId], references: [id])
  hallId           String
  hall             Hall      @relation(fields: [hallId], references: [id])
  startsAt         DateTime
  prices           Json      // { "VIP": 500, "Regular": 300 }  ETB per seat by section name
  status           String    @default("onsale")   // onsale | soldout | cancelled | closed
  counterCutoffMin Int       @default(30)
  holds            SeatHold[]
  tickets          Ticket[]
  @@index([startsAt])
  @@index([status])
}

// One seat, one row. Holding is an INSERT; the unique constraint refuses the second person.
model SeatHold {
  id        String   @id @default(cuid())
  showId    String
  show      Show     @relation(fields: [showId], references: [id])
  seat      String
  holderKey String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([showId, seat])
  @@index([expiresAt])
  @@index([holderKey])
}

model Ticket {
  id          String    @id @default(cuid())
  code        String    @unique
  showId      String
  show        Show      @relation(fields: [showId], references: [id])
  seats       String[]
  name        String
  phone       String
  telegramId  String?
  total       Int
  status      String    @default("RESERVED")   // RESERVED | CONFIRMED | CHECKED_IN | CANCELLED
  payMethod   String    @default("counter")    // counter | chapa
  chapaRef    String?
  idemKey     String?   @unique
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())
  @@index([showId, status])
  @@index([phone])
}

// ---------------- Watch: licensed films, video hosted elsewhere (Phase B) ----------------
model Film {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  titleAm     String?
  year        Int?
  runtimeMin  Int?
  rating      String?
  language    String    @default("Amharic")
  genre       String?
  descr       String?
  posterUrl   String?
  trailerUrl  String?   // YouTube trailer, playable without renting
  sourceKind  String    // youtube | mp4 | hls
  sourceUrl   String    // never a file on this server
  priceEtb    Int       @default(0)   // 0 = free
  rentHours   Int       @default(48)
  rights      String?   // who licensed it, for where, signed when — required before public
  rightsUntil DateTime?
  status      String    @default("draft")   // draft | public
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  rentals     Rental[]
}

model Rental {
  id         String    @id @default(cuid())
  code       String    @unique
  filmId     String
  film       Film      @relation(fields: [filmId], references: [id])
  name       String
  phone      String
  telegramId String?
  priceEtb   Int
  chapaRef   String?
  status     String    @default("PENDING")   // PENDING | ACTIVE | EXPIRED | CANCELLED
  startsAt   DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  @@index([phone])
  @@index([filmId, status])
}

// Programme listing: what a cinema is showing, as the cinema itself published it. Information only —
// tickets are bought at the cinema until the owner joins and the film becomes a Show with seats.
model Programme {
  id         String    @id @default(cuid())
  venueId    String
  venue      Venue     @relation(fields: [venueId], references: [id])
  title      String
  titleAm    String?
  hallName   String?   // "Gold 2 2D"
  times      String[]  // ["13:00", "16:00", "19:00"] Addis time
  dateFrom   DateTime
  dateTo     DateTime
  priceText  String?   // exactly as posted, e.g. "300 ብር"
  posterUrl  String?
  trailerUrl String?   // YouTube trailer (embedded with the YouTube player)
  notes      String?   // "Action · 2h25m · PG"
  sourceName String    // "Gast Cinema Telegram channel"
  sourceUrl  String
  postedAt   DateTime
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  @@index([venueId, dateTo])
}

// ---------------- BinaSmart Business: owners manage their own page ----------------
// A claim proves the caller holds the phone already on the shop/venue record. Approval is either a
// 6-digit code delivered in Telegram, or Ibrahim approving from ops when there is no Telegram id.
model OwnerClaim {
  id         String   @id @default(cuid())
  kind       String   // shop | venue
  shopId     String?
  shop       Shop?    @relation(fields: [shopId], references: [id])
  venueId    String?
  venue      Venue?   @relation(fields: [venueId], references: [id])
  phone      String
  name       String?
  code       String
  telegramId String?
  status     String   @default("PENDING")   // PENDING | VERIFIED | REJECTED | EXPIRED
  tries      Int      @default(0)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  @@index([phone, status])
}

model OwnerSession {
  id        String   @id @default(cuid())
  token     String   @unique
  kind      String   // shop | venue
  shopId    String?
  shop      Shop?    @relation(fields: [shopId], references: [id])
  venueId   String?
  venue     Venue?   @relation(fields: [venueId], references: [id])
  phone     String
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())
  expiresAt DateTime
  @@index([phone])
  @@index([expiresAt])
}

// One account can administer several things. This is the only place a business permission lives:
// the login is the same for everyone, what differs is what hangs off it.
model Membership {
  id           String    @id @default(cuid())
  userId       String
  user         AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String    // shop | venue | building
  shopId       String?
  shop         Shop?     @relation(fields: [shopId], references: [id])
  venueId      String?
  venue        Venue?    @relation(fields: [venueId], references: [id])
  buildingSlug String?
  role         String    @default("owner")   // owner | staff
  status       String    @default("active")  // active | suspended
  createdAt    DateTime  @default(now())
  @@index([userId])
  @@index([shopId])
  @@index([venueId])
  @@index([buildingSlug])
}

// Owner dashboard keys, one per login, stored as sha256 — never the key. See building/ownerKeys.js.
// Replaces Building.ownerKey, which held the key in plain text.
model OwnerKey {
  id         String    @id @default(cuid())
  buildingId String
  building   Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  keyHash    String    @unique
  label      String?   // login | add-building | migrated
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([buildingId])
}

// ===== Bini for owners on Telegram (owner Bini design §3) =====
// Who may use an owner assistant for a business. Numbers are approved by ops (ops/owner/access.js).
model OwnerAccess {
  id        String    @id @default(cuid())
  kind      String    // building (v1) | shop | venue | hotel | clinic
  entityId  String
  phoneKey  String    // ride/phone.js phoneKey(): display and rate limits only, never matching
  phoneE164 String    // the approved number in full (+2519…); all matching uses this
  role      String    @default("owner") // owner | staff
  label     String?
  addedBy   String    // ops | owner:<id>
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([phoneKey])
  @@index([phoneE164])
  @@index([kind, entityId])
}

// A Telegram account that proved, through Share-my-phone, that it holds an approved number.
model OwnerTgLink {
  id         String    @id @default(cuid())
  telegramId String    @unique
  chatId     String
  phoneKey   String    // display only
  phoneE164  String    // the number Telegram vouched for, in full
  mode       String    @default("owner") // owner | bini
  linkedAt   DateTime  @default(now())
  lastSeen   DateTime  @default(now())
  revokedAt  DateTime?
  revokedReason String? // self | dashboard | ops | replaced | access

  @@index([phoneKey])
  @@index([phoneE164])
}

// An agent is on for a business only while this row exists and is not disabled.
model AgentSwitch {
  id         String    @id @default(cuid())
  agent      String    // owner
  kind       String    // building
  entityId   String
  enabledAt  DateTime  @default(now())
  disabledAt DateTime?

  @@unique([agent, kind, entityId])
}

// Tenant messages (owner actions and messaging design §1.5): one batch per send, one row per recipient.
// A notice's text is kept once on the batch; invoices and receipts point at the invoice. No phone numbers here.
model OutboundBatch {
  id         String            @id @default(cuid())
  buildingId String?           // null for transactional SMS (sign-in codes, Plan D)
  kind       String            // notice | reminder | invoice | receipt | otp
  source     String            // daily-renewal | daily-due | daily-penalty | dashboard-send | receipt | backfill-audit | transactional
  actor      String?           // dashboard | cron | ops (Plan B: the owner access id)
  text       String?           // notices only
  total      Int               @default(0)
  createdAt  DateTime          @default(now())
  messages   OutboundMessage[]

  @@index([buildingId, createdAt])
}

model OutboundMessage {
  id         String        @id @default(cuid())
  batchId    String
  batch      OutboundBatch @relation(fields: [batchId], references: [id])
  buildingId String?
  tenancyId  String?
  userId     String?
  invoiceId  String?
  kind       String
  channel    String        // telegram | sms | none
  status     String        // queued | sent | delivered | failed | test
  smsParts   Int           @default(0)
  providerId String?
  errorKind  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([buildingId, createdAt])
  @@index([invoiceId])
  @@index([batchId])
  @@index([providerId])
}

// bina.et/i/<token>: one invoice or receipt, 60 days (design §1.3).
model InvoiceLink {
  id        String   @id @default(cuid())
  token     String   @unique
  invoiceId String
  kind      String   // invoice | receipt
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// An owner action waiting for ✅ (owner actions design §3.2). Bini's prepare tools write one row and nothing else; the
// owner's confirm moves it pending → running → done in one statement, so a second press, the expiry sweep or a second
// server can never run it twice. No phone number is stored here: payload holds ids, unit numbers and amounts, text
// holds the notice the owner confirmed, cardText the preview they read.
//
// cardText MAY HOLD AN OCCUPANT NAME. A preview for one unit reads back who it is about, and the owner is entitled to
// see that — they typed it in. It is stored so the result can be shown under the card the owner already read.
// It never reaches the model (the [[P1]] token rule in agents/owner replaces names before a turn), and it
// never leaves in a response: agents/owner/actions/history.js, which is the only thing that reads this table for
// the dashboard, does not select it. Anything new that reads OwnerAction must leave it, and args and payload, where
// they are.
model OwnerAction {
  id           String    @id                  // 22 random URL-safe characters; the only thing a button carries
  buildingId   String
  kind         String    // message | remind_unpaid | send_invoice | create_invoices | record_payment
  status       String    @default("pending")  // pending | running | done | failed | refused | cancelled | expired | replaced
  channel      String    // owner-telegram | owner-web
  preparedBy   String    // OwnerAccess id, or dashboard
  preparedRole String    // owner | staff | dashboard
  preparedTg   String?   // the Telegram id it was prepared from (owner-telegram only)
  args         Json      // what the owner asked for, as the prepare tool validated it
  payload      Json      // the resolved recipients and figures: tenancy, invoice ids, units, amounts
  text         String?   // message: the exact notice text
  cardText     String?   // the preview the owner read, kept so the result can be shown under it
  fingerprint  String    // hash of the figures that must still hold at confirm
  bulk         Boolean   @default(false)
  urgent       Boolean   @default(false)
  cards        Json?     // [{ chatId, messageId }] — the Telegram cards to edit with the result
  confirmedBy  String?   // OwnerAccess id, or dashboard
  confirmedAt  DateTime?
  result       Json?     // counts, batch ids, or the error kind
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([buildingId, createdAt])
  @@index([status, expiresAt])
  @@index([buildingId, bulk, confirmedAt])
}

// ===== Business assistants (workspaces/) — 2026-09-17 =====
// One Workspace per client company. Its documents and their chunks live in these tables only, never in
// KnowledgeChunk: the public index (Bini, the agents, MCP search) loads KnowledgeChunk whole, so a client's
// private text there would be served to everyone. Chunk vectors are BGE-M3 (bina-embed, local), so a client's
// documents are never sent to an outside embedding service. Keys are stored as sha256 hashes only.
model Workspace {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  color       String   @default("#059669")
  lang        String   @default("am")          // default reply language: am | en | om
  welcome     String?                          // first message in the chat bubble
  about       String?                          // one paragraph the assistant is told about the company
  secretHash  String   @unique                 // sha256 of the server key (bsk_…), for the API and the dashboard
  siteKey     String   @unique                 // public key (bpk_…) for the website bubble; useless off the allowed origins
  origins     String[] @default([])            // allowed website origins for siteKey, e.g. https://example.com
  dailyLimit  Int      @default(100)           // questions per day (free plan)
  plan        String   @default("free")        // free | business | enterprise
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkspaceDoc {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  url         String?
  kind        String   // text | url | pdf
  lang        String   @default("en")
  chars       Int      @default(0)
  createdAt   DateTime @default(now())
  @@index([workspaceId])
}

model WorkspaceChunk {
  id          String   @id @default(cuid())
  workspaceId String
  docId       String
  ord         Int
  heading     String?
  text        String
  vec         Bytes?   // BGE-M3, 1024 float32, L2-normalised
  createdAt   DateTime @default(now())
  @@index([workspaceId])
  @@index([docId])
}

model WorkspaceQuestion {
  id          String   @id @default(cuid())
  workspaceId String
  channel     String   // api | site
  lang        String   @default("en")
  question    String
  answered    Boolean  @default(true)
  ms          Int      @default(0)
  createdAt   DateTime @default(now())
  @@index([workspaceId, createdAt])
}

// ===== Jobs (2026-09-21) =====
// A vacancy always belongs to an employer, and the employer record is built from the first job that
// names it and enriched later. That way the company profile grows by itself as more of its jobs arrive,
// and after a season the platform holds something no Ethiopian site has: a real register of employers
// with what they actually hire for.
model Employer {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  nameAm    String?
  sector    String?
  city      String   @default("Addis Ababa")
  about     String?
  website   String?
  phone     String?
  email     String?
  logoUrl   String?
  verified  Boolean  @default(false)   // somebody confirmed this is the real company, not a broker

  // Where it actually is. Researched per employer, not guessed from the advert: an address typed by a
  // recruiter ("around Bole") is not a place, and a job seeker who travels to the wrong gate loses a day
  // and the fare. lat/lng are what make the rest work - the office can be a ride destination and a point
  // on the map, so a person can see what getting to the interview costs before deciding to apply.
  address        String?
  lat            Float?
  lng            Float?
  locationNote   String?   // "3rd floor, behind the Total station" - what a taxi driver actually needs
  locationChecked DateTime? // when a human last confirmed the coordinates, not when the row was written
  buildingId     String?   // when the employer sits in a building BinaSmart already knows
  building       Building? @relation(fields: [buildingId], references: [id])
  jobs      Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Job {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  titleAm     String?
  employerId  String
  employer    Employer  @relation(fields: [employerId], references: [id])
  city        String    @default("Addis Ababa")
  jobType     String?   // full-time | part-time | contract | internship | temporary
  experience  String?   // as the advert states it, never our own guess
  education   String?
  salary      String?   // text, not a number: most Ethiopian adverts say "as per company scale"
  vacancies   Int?      // how many posts, when the advert says
  summary     String
  bodyHtml    String?
  howToApply  String?
  deadline    DateTime?
  // The field of work, worked out from the title by jobs/categories.js - a rule list, not a model, so
  // the same advert lands in the same place every day and a category page can be ranked.
  category    String?
  // Some sources publish the vacancy itself as a photographed notice - the positions, the requirements
  // and the salary live inside the image, not in the page text. We copy that image to our own server and
  // show it, so the reader sees exactly what the employer published rather than our transcription of it.
  imageUrl    String?
  sourceUrl   String?
  sourceName  String?
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  // When this vacancy went out on the Telegram channel. Null means "not announced yet"; the announcer
  // batches new vacancies rather than posting 200 separate messages a day, which would empty a channel
  // faster than it fills it.
  announcedAt DateTime?

  @@index([deadline])
  @@index([employerId])
}

// Somebody who wants to hear when a job in their field opens (2026-09-22).
//
// The board has thousands of vacancies and almost no returning readers: a job seeker looks once and
// forgets the site. An alert reverses that - they choose a field once, and every morning the vacancies
// that matter to them arrive in Telegram. It is the cheapest retention we can build, because the
// channel, the categories and the bot already exist.
//
// One row per chat per field. lastSentAt is what stops a vacancy being sent twice; a new subscriber
// starts from the moment they subscribe, never with a dump of the archive.
model JobAlert {
  id         String   @id @default(cuid())
  chatId     String
  field      String                        // a jobs/categories.js slug, or "all"
  city       String?
  lang       String   @default("am")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastSentAt DateTime @default(now())
  sentCount  Int      @default(0)

  @@unique([chatId, field])
  @@index([active])
}

// A company asking us to look at the system their staff struggle with — LMIS, Musaned, an embassy
// portal, anything (2026-09-22).
//
// What we promise on the page is an ASSESSMENT, not a delivery date: "show us your system and in 3-5
// days we tell you exactly what we can do, free". That is a promise we can always keep, and the owner's
// rule is that we work only with licensed companies and government offices - so the licence and TIN/VAT
// are asked for at first contact rather than discovered later.
model AiAssessment {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  org         String                      // the company or office
  contact     String                      // who is asking
  phone       String
  email       String?
  licence     String?                     // trade licence number
  tin         String?                     // TIN / VAT number
  systems     String?                     // which systems they use
  pain        String?                     // what their staff get stuck on
  sector      String?                     // agency | bank | hospital | government | other
  status      String   @default("new")    // new | assessing | answered | declined
  note        String?

  @@index([status, createdAt])
}

// A vacancy somebody asked us to publish — from Bini in chat, from an employer, from a form.
//
// It does NOT go on the board. It waits here until a person approves it, and that is the whole point:
// job scams are the commonest fraud against Ethiopian workers (fake vacancy, "pay the registration
// fee", vanish), the board now carries real people's CVs, and no model can tell a real employer from a
// well-written one. So an advert reaches the public only when a human said yes.
//
// checks holds what the automatic tests noticed - a fee demanded, a personal phone, an employer we have
// never seen - so the reviewer reads the reasons rather than a verdict.
// "Tell me when a tender in my line of business opens" (tenders/alerts.js). The same shape as JobAlert, a
// table of its own so a tender subscriber never shares a row, a counter or a unique key with a job seeker.
model TenderAlert {
  id         String   @id @default(cuid())
  chatId     String
  cat        String                        // a tenders/alerts.js CATS slug, or "all"
  lang       String   @default("am")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastSentAt DateTime @default(now())
  sentCount  Int      @default(0)

  @@unique([chatId, cat])
  @@index([active])
}

// A place review from a completed ride whose drop-off is at the named place (ride/placeReviews.js). One per ride.
model PlaceReview {
  id         String   @id @default(cuid())
  rideId     String   @unique
  placeRef   String                        // the OpenStreetMap element, "node/123" - ride/gazetteer.js
  placeName  String
  lat        Float
  lng        Float
  stars      Int
  text       String?
  textStatus String   @default("none")     // none | pending | published | hidden - words wait for a person
  token      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([placeRef])
}

// A company address that still works after its row was merged into another (ops/jobs/clean-employers.js):
// /employer/<slug> answers 301 to the company it became, so Google and shared links keep their way in.
model EmployerAlias {
  slug       String   @id
  employerId String
  createdAt  DateTime @default(now())

  @@index([employerId])
}

model JobSubmission {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  source       String    @default("bini")   // bini | form | telegram | api
  submitter    String?                      // who sent it, as they identified themselves
  submitterRef String?                      // chat id, phone or ip - for rate limiting and follow-up

  employerName String
  title        String
  titleAm      String?
  city         String?
  jobType      String?
  salary       String?
  summary      String?
  bodyHtml     String?
  howToApply   String?
  deadline     DateTime?

  checks       String?                      // what looked wrong, in plain words
  status       String    @default("pending") // pending | published | rejected
  token        String    @unique            // the approve/reject link's secret
  reviewedAt   DateTime?
  reviewNote   String?
  jobId        String?                      // the published Job, once approved

  @@index([status, createdAt])
}

// A person who sent a CV through bina.et (2026-09-21).
//
// This table holds real people's documents, so the rules are written here rather than left to whoever
// reads the code next:
//   · the file never leaves this server. It is stored on disk, not in a cloud bucket, not in a backup
//     that travels, and it is not attached to an email.
//   · shareWider is FALSE unless the person ticked the box. It is the difference between "send my CV to
//     this employer" and "send my CV to whoever you like", and only they can make that choice.
//   · deleteAfter is set on every row. A CV is not ours to keep for ever; when the date passes the row
//     and the file go. Somebody who sent a CV in 2026 should not find it circulating in 2029.
//   · the parsed summary is for matching, never for publishing. No profile page, no directory of job
//     seekers - a public database of people looking for work is a database of people to exploit.
model Candidate {
  id           String    @id @default(cuid())
  name         String
  phone        String
  email        String?
  city         String?
  category     String?              // the field of work, so a CV can be matched to the right vacancy
  jobId        String?              // the vacancy they applied for, when they came from one
  employerId   String?              // resolved from that vacancy, kept if the job row is later removed
  cvPath       String               // on this server only
  cvMime       String?
  summary      String?              // short profile extracted from the CV, for matching
  skills       String[]  @default([])
  years        Int?
  shareWider   Boolean   @default(false)   // may we show this CV to other employers in the same field?
  sentTo       String[]  @default([])      // employer ids the CV has been forwarded to, so none twice
  status       String    @default("new")   // new | reviewed | forwarded | hired | withdrawn
  note         String?
  createdAt    DateTime  @default(now())
  deleteAfter  DateTime                     // retention: the row and the file go after this date

  @@index([category])
  @@index([jobId])
  @@index([createdAt])
}

// Where a person is in a conversation with @bina_smart_bot. The bot is otherwise stateless - every
// message is answered on its own - which is right for questions and wrong for the one flow that takes
// more than a message: speaking a CV. Kept in the database rather than in memory so a restart in the
// middle does not silently swallow somebody's voice note, and swept by age, not by hand.
model BotState {
  chatId    String   @id
  state     String                          // cv_wait_voice | cv_wait_phone
  data      Json?                           // what has been gathered so far
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// A web address a vacancy used to live at. Renaming a job's slug improves the address a person reads
// and a search engine ranks - but the old one is already in Google's index, in a Telegram message, in
// somebody's bookmarks. This table is what turns a rename into a redirect instead of a 404.
model JobAlias {
  slug      String   @id
  jobId     String?                       // the vacancy it became, when it became one
  // Or a page it became instead. An aggregated notice ("8 Positions") is not one vacancy and must not
  // redirect to whichever of the eight happened to be created first; it redirects to the employer,
  // where all eight are listed.
  path      String?
  createdAt DateTime @default(now())

  @@index([jobId])
}
