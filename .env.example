# BinaSmart environment — copy to .env and fill in. NEVER commit the real .env.

# Core
DATABASE_URL=postgresql://user:password@localhost:5432/binasmart
PORT=4210

# Auth (better-auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://bina.et
AUTH_DISABLE_SIGNUP=false

# Owner dashboard
OWNER_KEY=

# Bini AI — cloud LLM (OpenAI- or Anthropic-compatible). Leave BINI_API_BASE
# empty to run on the local GLM fallback only.
BINI_API_FORMAT=openai
BINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
BINI_API_MODEL=gemini-2.5-flash-lite
BINI_API_KEY=

# Bini AI — local GLM fallback (Anthropic-compatible)
GLM_BASE=http://127.0.0.1:4000
GLM_KEY=
GLM_MODEL=glm-5-turbo

# Payments (Chapa)
CHAPA_MODE=test
CHAPA_PUBLIC_TEST=
CHAPA_SECRET_TEST=

# Social posting
BINA_FB_PAGE_ID=
BINA_FB_PAGE_TOKEN=
BINASMART_TG_TOKEN=
BINA_TG_CHANNEL=@binasmart
